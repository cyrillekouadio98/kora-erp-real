# Copiez ce fichier en .env et remplacez chaque valeur en production (secrets issus du coffre).
# Avec NODE_ENV=production, l'API refuse de démarrer si une variable manque ou garde la valeur
# de développement ci-dessous (clé de chiffrement, URL et mots de passe PostgreSQL, WEB_URL).
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# Trois rôles PostgreSQL distincts (cf. infra/db/init.sql)
DATABASE_OWNER_URL=postgres://kora_owner:kora_owner_dev@localhost:5432/kora
DATABASE_APP_URL=postgres://kora_app:kora_app_dev@localhost:5432/kora
DATABASE_PLATFORM_URL=postgres://kora_platform:kora_platform_dev@localhost:5432/kora

SESSION_TTL_HOURS=12
# Proxys de confiance devant l'API (adresse IP réelle du client pour la limite de débit et le journal) :
# 1 = l'interface Next.js seule ; 2 = un répartiteur de charge devant Next.js ; ou « loopback, 10.0.0.0/8 ».
TRUST_PROXY=1
# 32 octets en base64 : openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZXMta2V5LWNoYW5nZS1tZSE=
# Prestataire de paiement de test : ignoré en production, où il n'est jamais branché.
PAYMENT_SANDBOX_SECRET=sandbox-secret-dev
JOBS_ENABLED=true
BILLING_INTERVAL_MS=600000

# Premier super administrateur de la plateforme (créé par db:seed)
SEED_SUPERADMIN_EMAIL=admin@kora.local
SEED_SUPERADMIN_PASSWORD=ChangezMoi-2026!
