# Modèle du fichier infra/prod/.env (production). Ne remplissez pas ce modèle à la main :
#   ./infra/prod/generate-env.sh <domaine> <email>
# génère infra/prod/.env avec des secrets aléatoires (fichier jamais versionné, lisible par root seul).

# Nom de domaine public (enregistrement DNS A vers l'IP du serveur) et e-mail pour Let's Encrypt
DOMAIN=app.exemple.ci
ACME_EMAIL=admin@exemple.ci

# PostgreSQL : superutilisateur (initialisation uniquement) et les trois rôles de Kora
POSTGRES_SUPERUSER_PASSWORD=
KORA_OWNER_PASSWORD=
KORA_APP_PASSWORD=
KORA_PLATFORM_PASSWORD=

# Clé de chiffrement des secrets de double authentification (32 octets en base64).
# Ne la changez jamais après la mise en service : les secrets déjà chiffrés deviendraient illisibles.
ENCRYPTION_KEY=

# E-mails (facultatif) : serveur SMTP (Brevo, Mailjet…) et expéditeur. Sans SMTP_URL, les e-mails
# restent consultables dans Kora sans être envoyés. Redéployez après modification (deploy.sh).
# SMTP_URL=smtp://utilisateur:motdepasse@smtp-relay.brevo.com:587
# MAIL_FROM=Kora ERP <no-reply@exemple.ci>

# Premier super administrateur de la console éditeur, créé au premier démarrage.
# Retirez ces deux lignes de .env après la première connexion (et activez la double authentification).
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
